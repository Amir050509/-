{
  "name": "amir050509/krug-social",
  "description": "Yii2 powered social network starter",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*",
    "yiisoft/yii2": "~2.0.52"
  },
  "autoload": {
    "psr-4": { "app\\": "./" }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "process-timeout": 1800,
    "sort-packages": true
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t web"
  }
}
